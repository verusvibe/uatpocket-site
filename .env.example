# All values are public and embedded during static export. Never put secrets here.
# Origin only, e.g. https://verusvibe.github.io
NEXT_PUBLIC_SITE_URL=
# Empty for a root/custom domain; /uatpocket-site for the GitHub repository URL.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_COPYRIGHT_OWNER=
NEXT_PUBLIC_COPYRIGHT_YEAR=2026
NEXT_PUBLIC_SUPPORT_EMAIL=
# Set a real number, or none if telephone support is not offered.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SECURITY_EMAIL=
# Set this only when publishing with the app release.
NEXT_PUBLIC_EFFECTIVE_DATE=
NEXT_PUBLIC_EARLY_ACCESS_ENDPOINT=
NEXT_PUBLIC_SUPPORT_ENDPOINT=
